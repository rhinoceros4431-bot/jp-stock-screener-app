# このファイルを .env にコピーして値を入力し、環境変数として読み込んでください
# (Render/Railway等にデプロイする場合は、各サービスの「環境変数」設定画面に同じ内容を入力します)

VAPID_PUBLIC_KEY=(README記載のものをそのまま使うか、python generate_vapid_keys.pyで再生成)
VAPID_PRIVATE_KEY=(同上・絶対に公開しないこと)
VAPID_CONTACT_EMAIL=mailto:your_email@example.com

# 管理用エンドポイント(/api/run-now)を保護する任意のトークン。空でもOK。
ADMIN_TOKEN=change_me_to_a_random_string

# スクリーニングの実行間隔(分)。市場時間内(平日9:00-15:30 JST)のみ実行されます。
RUN_INTERVAL_MINUTES=60
